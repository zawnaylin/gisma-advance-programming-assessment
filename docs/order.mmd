classDiagram
    class Order
    Order: -String id
    Order: -OrderStatus status
    Order: -String cancelledBy
    Order: -String cancellationReason
    Order "1" -- "0..*" OrderItem: contains
    Order ..> OrderStatus: status

    class OrderStatus
    <<enumeration>> OrderStatus
    OrderStatus: PENDING
    OrderStatus: CONFIRMED
    OrderStatus: READY
    OrderStatus: SERVED
    OrderStatus: CANCELLED

    class OrderItem
    OrderItem: -String id
    OrderItem: -String orderId
    OrderItem: -String menuItemId
    OrderItem: -Integer quantity
    OrderItem: -Float price