@startuml use-case
title QR Restaurant Ordering System - Use Case Diagram

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #4A78B5
  ArrowColor #5B6B79
  FontColor #26333F
}
skinparam actor {
  BorderColor #4A78B5
  BackgroundColor #F5F9FF
  FontColor #26333F
}
skinparam note {
  BackgroundColor #FFF9E6
  BorderColor #D8C46A
}

actor Customer as c
actor "Kitchen Staff" as ks
actor Waiter as w

rectangle "QR Restaurant Ordering System" {

  ' -- dining flow --
  usecase "Choose Table"            as choose_table
  usecase "View Table Availability" as view_table
  usecase "Scan QR Code"            as scan_qr
  usecase "View Menu"               as view_menu
  usecase "Place Order"             as place_order
  usecase "Track Order Status"      as track_order
  usecase "End Order"               as end_order

  ' -- kitchen flow --
  usecase "View Incoming Orders"    as view_orders
  usecase "Update Order Status"     as update_status
  usecase "Cancel Order"            as cancel_order

  ' -- table lifecycle --
  usecase "Show Table QR"           as show_qr
  usecase "End Dining Session"      as end_session
  usecase "Mark Table Cleaned"      as clean_table

  ' -- system --
  usecase "Cancel Unfinished Orders" as cancel_unfinished
}

' keep customer on the left, kitchen staff and waiter on the right
c -[hidden]right- ks

' ---- customer flow ----
c --> choose_table
choose_table ..> view_table : <<include>>

c --> scan_qr
scan_qr ..> view_menu : <<include>>

c --> place_order
place_order ..> view_menu : <<include>>

c --> track_order
c --> end_order
end_order ..> cancel_unfinished : <<include>>

' ---- kitchen staff and waiter flow ----
ks --> view_orders
w --> view_orders
ks --> update_status
w --> update_status
ks --> cancel_order

w --> show_qr
w --> end_session
end_session ..> cancel_unfinished : <<include>>
w --> clean_table

legend bottom
  <b>Rules</b>
  * <b>View Table Availability</b> and <b>View Incoming Orders</b> update live (server push); unconfirmed (PENDING) orders show their items.
  * <b>Update Order Status</b>: Kitchen Staff PENDING -> CONFIRMED -> READY; Waiter READY -> SERVED
    (the Serve button is on the kitchen screen).
  * Out of scope: staff accounts, login and role checks. The kitchen (/kitchen) and waiter (/staff/tables)
    screens are open to anyone who knows the URL.
  * <b>Cancel Order</b>: Kitchen Staff, only while PENDING or CONFIRMED.
  * <b>End Order</b> (customer, confirms if orders are unfinished) and <b>End Dining Session</b> (waiter):
    session -> WAITING_FOR_CLEANING (no more orders), table -> WAITING_FOR_CLEANING.
  * <b>Cancel Unfinished Orders</b>: the order module reacts to the DiningSessionEnded event;
    PENDING / CONFIRMED orders are cancelled, READY orders stay to be served.
  * <b>Mark Table Cleaned</b>: only while WAITING_FOR_CLEANING; session -> COMPLETED, table -> AVAILABLE.
endlegend

@enduml
