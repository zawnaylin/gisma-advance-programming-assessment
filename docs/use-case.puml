@startuml use-case
title QR Restaurant Ordering System - Use Case Diagram

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #4A78B5
  ArrowColor #5B6B79
  FontColor #26333F
}
skinparam actor {
  BorderColor #4A78B5
  BackgroundColor #F5F9FF
  FontColor #26333F
}
skinparam note {
  BackgroundColor #FFF9E6
  BorderColor #D8C46A
}

actor Customer as c
actor Staff as staff
actor "Kitchen Staff" as ks
actor Waiter as w

ks --|> staff
w --|> staff

rectangle "QR Restaurant Ordering System" {

  ' -- dining flow --
  usecase "Choose Table"            as choose_table
  usecase "View Table Availability" as view_table
  usecase "Scan QR Code"            as scan_qr
  usecase "View Menu"               as view_menu
  usecase "Place Order"             as place_order
  usecase "Track Order Status"      as track_order

  ' -- staff flow --
  usecase "Authenticate"            as authenticate
  usecase "View Incoming Orders"    as view_orders
  usecase "Update Order Status"     as update_status
  usecase "Cancel Order"            as cancel_order

  ' -- table lifecycle --
  usecase "Mark Table Cleaned"      as clean_table
}

' keep customer on the left, staff on the right
c -[hidden]right- staff

' ---- customer flow ----
c --> choose_table
choose_table ..> view_table : <<include>>

c --> scan_qr
scan_qr ..> view_menu : <<include>>

c --> place_order
place_order ..> view_menu : <<include>>

c --> track_order
c --> cancel_order

' ---- staff flow ----
staff --> authenticate
staff --> view_orders
ks --> update_status
w --> update_status
ks --> cancel_order
w --> clean_table

note right of update_status
  Kitchen Staff: PENDING -> CONFIRMED (accept & start cooking)
  Kitchen Staff: CONFIRMED -> COMPLETED (ready to serve)
  Waiter:        COMPLETED -> SERVED
end note

note bottom of cancel_order
  Customer or Kitchen Staff.
  Only allowed while status = PENDING or CONFIRMED.
end note

@enduml